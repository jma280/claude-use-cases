{
  "rules": {
    "rooms": {
      "$code": {
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || data.child('host').val() === auth.uid)",
        "host": { ".read": "auth != null" },
        "public": { ".read": "auth != null" },
        "teams": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && data.parent().parent().child('host').exists()",
            ".validate": "newData.hasChildren(['name', 'emoji']) && newData.child('name').isString() && newData.child('name').val().length <= 40 && newData.child('emoji').isString() && newData.child('emoji').val().length <= 16"
          }
        },
        "inputs": {
          ".read": "auth != null && data.parent().child('host').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && data.parent().parent().child('host').exists()",
            ".validate": "newData.child('t').isString() && newData.child('t').val().length <= 12 && (!newData.child('text').exists() || (newData.child('text').isString() && newData.child('text').val().length <= 120))"
          }
        }
      }
    }
  }
}
